# Copy to .env and fill in. Never commit .env.

# Must remain "paper". Any other value is rejected at process start.
TRADING_MODE=paper

# Optional. If empty, the loop uses deterministic fixture bars (no network).
POLYGON_API_KEY=

# Watchlist (comma-separated)
WATCHLIST=SPY,QQQ

# Paper account
STARTING_EQUITY=100000

# Risk
DAILY_DRAWDOWN_PCT=2.0
MAX_OPEN_POSITIONS=3
MAX_RISK_PER_TRADE_PCT=1.0
SLIPPAGE_BPS=5

# Session buffers (America/New_York)
OPEN_BUFFER_MINUTES=15
LUNCH_START=11:45
LUNCH_END=13:15
CLOSE_BUFFER_MINUTES=15

# Optional: tickers that must not be entered (earnings stub)
EARNINGS_BLACKOUT=

# Optional VIX halt (ignored if no VIX quote)
VIX_HALT_LEVEL=40

# Paths (relative to process cwd)
DATA_DIR=data
KILL_FILE=data/KILL
JOURNAL_DB=data/pa.db

# Loop
BAR_TIMEFRAME_MINUTES=1
POLL_SECONDS=60
# 0.0.0.0 so phones/laptops on Wi-Fi can open the desk.
# 8776 is PA. Do not reuse 8765 (Precision) or 8766 (ChopTrading).
API_HOST=0.0.0.0
API_PORT=8776

# Fast EMA / slow EMA / RSI
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_LOW=30
RSI_HIGH=70

# P1/P2 optional
VIX_SIZE_DOWN_LEVEL=25
TRAIL_PCT=1.5
SCALE_OUT_GAIN_PCT=20
WEBHOOK_URL=
FINNHUB_API_KEY=
OPENAI_API_KEY=
NEWS_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
PAPER_BROKER=internal

# Optional: SignalValidator desk (Robinhood babysitter snapshot)
SIGNALVALIDATOR_URL=http://127.0.0.1:8799

# Telegram — Chat Signals bot. TAKE Buy lines post here the moment they print.
PA_TELEGRAM_BOT_TOKEN=
PA_TELEGRAM_CHAT_ID=

